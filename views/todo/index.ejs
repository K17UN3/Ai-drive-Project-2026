<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TODO App</title>
  <style>
    body { font-family: sans-serif; max-width: 600px; margin: 2rem auto; padding: 0 1rem; }
    .form-group { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
    .form-group input[type="text"] { flex: 1; padding: 0.5rem; font-size: 1rem; }
    .form-group button { padding: 0.5rem 1rem; font-size: 1rem; cursor: pointer; }
    .error-box { background-color: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; display: none; }
    .todo-items { list-style: none; padding: 0; margin: 0; }
    .todo-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0; border-bottom: 1px solid #e5e7eb; }
    .todo-item.completed .title { text-decoration: line-through; color: #9ca3af; }
    .todo-item .title { flex: 1; }
    .btn-delete { background-color: #ef4444; color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 4px; cursor: pointer; }
    .empty-msg { color: #6b7280; font-style: italic; }
  </style>
</head>
<body>
  <h1>TODO 管理</h1>

  <div id="error-message" class="error-box"></div>

  <form id="todo-form">
    <div class="form-group">
      <input type="text" id="todo-title" placeholder="TODOを入力 (100文字以内)" maxlength="100" required>
      <button type="submit">追加</button>
    </div>
  </form>

  <div id="todo-list">
    <p>読み込み中...</p>
  </div>

  <script src="/todo/todo.js"></script>
</body>
</html>