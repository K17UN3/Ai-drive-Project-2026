<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    body { font-family: sans-serif; max-width: 720px; margin: 24px auto; padding: 0 16px; line-height: 1.5; color: #222; }
    .hidden { display: none !important; }
    .header-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; margin-bottom: 16px; }
    .room-badge { background: #2563eb; color: #fff; padding: 4px 12px; border-radius: 999px; font-weight: bold; font-size: 0.9rem; }
    .error-banner { background: #fee2e2; border: 1px solid #ef4444; color: #991b1b; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; }
    .wait-box { background: #fef3c7; border: 1px solid #f59e0b; padding: 24px; border-radius: 8px; text-align: center; }
    #message-list { border: 1px solid #d1d5db; border-radius: 8px; height: 380px; overflow-y: auto; padding: 12px; background: #f9fafb; margin-bottom: 16px; }
    .chat-item { background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 8px 12px; margin-bottom: 8px; }
    .chat-meta { font-size: 0.85rem; color: #4b5563; margin-bottom: 4px; font-weight: bold; }
    .chat-body { margin: 0; white-space: pre-wrap; word-break: break-word; }
    .form-group { margin-bottom: 12px; }
    label { display: block; font-weight: bold; margin-bottom: 4px; font-size: 0.9rem; }
    input[type="text"], textarea { width: 100%; box-sizing: border-box; padding: 8px; border: 1px solid #9ca3af; border-radius: 4px; font-size: 1rem; }
    button { background: #2563eb; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; font-size: 1rem; cursor: pointer; }
    button:disabled { background: #9ca3af; cursor: not-allowed; }
  </style>
</head>
<body>
  <div class="header-bar">
    <h1><%= title %></h1>
    <div>
      <span id="room-status" class="room-badge">接続中...</span>
      <a href="/" style="margin-left: 12px; font-size: 0.9rem;">TOPへ戻る</a>
    </div>
  </div>

  <!-- エラー通知バナー -->
  <div id="error-banner" class="error-banner hidden" role="alert"></div>

  <!-- 1. 初期接続中表示 -->
  <div id="loading-view">
    <p>チャットルームへ接続しています...</p>
  </div>

  <!-- 2. 満席待機画面（6人目以降：履歴・フォーム非表示） -->
  <div id="full-wait-view" class="wait-box hidden">
    <h2>現在チャットルームが満席です</h2>
    <p>定員（5名）に達しているため、現在入室・閲覧・投稿はできません。</p>
    <p>空き枠が発生次第、自動的に入室します（自動確認中...）。</p>
  </div>

  <!-- 3. チャットメイン画面（入室成功時のみ表示） -->
  <div id="chat-main-view" class="hidden">
    <div id="message-list" aria-live="polite"></div>

    <form id="chat-form">
      <div class="form-group">
        <label for="user-name-input">ユーザー名（1〜20文字・絵文字不可）</label>
        <input type="text" id="user-name-input" maxlength="20" placeholder="例: 学生A" required />
      </div>
      <div class="form-group">
        <label for="comment-input">コメント（1〜500文字・空行は自動整形）</label>
        <textarea id="comment-input" rows="3" maxlength="500" placeholder="メッセージを入力..." required></textarea>
      </div>
      <button type="submit" id="send-button">送信</button>
    </form>
  </div>

  <script src="/chat/chat.js"></script>
</body>
</html>